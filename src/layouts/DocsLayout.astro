---
import BaseLayout from "./BaseLayout.astro";
import CodeBusterHeader from "../components/CodeBusterHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import DocsNavigation from "../components/DocsNavigation.astro";
import "../styles/code-buster.css";
import "../styles/docs.css";

interface Props {
  frontmatter: {
    title: string;
    description?: string;
  };
}

const { frontmatter } = Astro.props;
const currentPath = Astro.url.pathname.replace(/\/$/, "");
type DocsLink = readonly [string, string];
type DocsGroup = {
  readonly label: string;
  readonly links: readonly DocsLink[];
};
const groups: readonly DocsGroup[] = [
  {
    label: "Getting started",
    links: [
      ["Installation", "/codebuster/docs/getting-started/installation"],
      ["Quickstart", "/codebuster/docs/getting-started/quickstart"],
    ],
  },
  {
    label: "Guides",
    links: [
      ["Configuration", "/codebuster/docs/guides/configuration"],
      ["Analysis workflows", "/codebuster/docs/guides/workflows"],
      ["CI and integrations", "/codebuster/docs/guides/integrations"],
    ],
  },
  {
    label: "Reference",
    links: [
      ["Commands", "/codebuster/docs/reference/commands"],
      ["Reports", "/codebuster/docs/reference/reports"],
      ["Languages", "/codebuster/docs/reference/languages"],
    ],
  },
  {
    label: "Project",
    links: [
      ["Contributing", "/codebuster/docs/project/contributing"],
      ["Security and releases", "/codebuster/docs/project/security-releases"],
    ],
  },
] as const;

const links = groups.flatMap((group) => group.links);
const currentIndex = links.findIndex(([, href]) => href === currentPath);
const previous = currentIndex > 0 ? links[currentIndex - 1] : undefined;
const next = currentIndex >= 0 && currentIndex < links.length - 1 ? links[currentIndex + 1] : undefined;
const currentLabel = currentIndex >= 0 ? links[currentIndex][0] : "Documentation";
---

<BaseLayout
  title={`${frontmatter.title} - Code Buster docs`}
  description={frontmatter.description ?? `Code Buster documentation: ${frontmatter.title}.`}
  bodyClass="code-buster-page docs-page"
>
  <CodeBusterHeader />
  <div class="wrap docs-shell">
    <aside class="docs-sidebar" aria-label="Documentation navigation">
      <DocsNavigation groups={groups} currentPath={currentPath} />
    </aside>
    <details class="docs-mobile-navigation">
      <summary>
        <span>Browse documentation</span>
        <strong>{currentLabel}</strong>
      </summary>
      <div class="docs-mobile-navigation-content">
        <DocsNavigation groups={groups} currentPath={currentPath} labelSuffix=" mobile" />
      </div>
    </details>
    <main id="main-content" class="docs-main">
      <article class="docs-content">
        <slot />
      </article>
      <nav class="docs-pagination" aria-label="Documentation pagination">
        {previous ? <a rel="prev" href={previous[1]}><span>Previous</span><strong>← {previous[0]}</strong></a> : <span></span>}
        {next ? <a rel="next" href={next[1]}><span>Next</span><strong>{next[0]} →</strong></a> : <span></span>}
      </nav>
    </main>
  </div>
  <SiteFooter variant="code-buster" />
  <script is:inline src="/codebuster/docs.js"></script>
</BaseLayout>
