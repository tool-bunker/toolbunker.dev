---
import BaseLayout from "./BaseLayout.astro";
import CodeBusterHeader from "../components/CodeBusterHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import "../styles/code-buster.css";
import "../styles/docs.css";

interface Props {
  frontmatter: {
    title: string;
    description?: string;
  };
}

const { frontmatter } = Astro.props;
const currentPath = Astro.url.pathname.replace(/\/$/, "");
const groups = [
  {
    label: "Getting started",
    links: [
      ["Installation", "/codebuster/docs/getting-started/installation"],
      ["Quickstart", "/codebuster/docs/getting-started/quickstart"],
    ],
  },
  {
    label: "Guides",
    links: [
      ["Configuration", "/codebuster/docs/guides/configuration"],
      ["Analysis workflows", "/codebuster/docs/guides/workflows"],
      ["CI and integrations", "/codebuster/docs/guides/integrations"],
    ],
  },
  {
    label: "Reference",
    links: [
      ["Commands", "/codebuster/docs/reference/commands"],
      ["Reports", "/codebuster/docs/reference/reports"],
      ["Languages", "/codebuster/docs/reference/languages"],
    ],
  },
  {
    label: "Project",
    links: [
      ["Contributing", "/codebuster/docs/project/contributing"],
      ["Security and releases", "/codebuster/docs/project/security-releases"],
    ],
  },
] as const;
---

<BaseLayout
  title={`${frontmatter.title} - Code Buster docs`}
  description={frontmatter.description ?? `Code Buster documentation: ${frontmatter.title}.`}
  bodyClass="code-buster-page docs-page"
>
  <CodeBusterHeader />
  <div class="wrap docs-shell">
    <aside class="docs-sidebar" aria-label="Documentation navigation">
      <a href="/codebuster/docs/">CODE BUSTER / DOCS</a>
      {groups.map((group) => (
        <nav class="docs-group" aria-label={group.label}>
          <strong>{group.label}</strong>
          {group.links.map(([label, href]) => (
            <a href={href} aria-current={currentPath === href ? "page" : undefined}>{label}</a>
          ))}
        </nav>
      ))}
    </aside>
    <article class="docs-content">
      <slot />
    </article>
  </div>
  <SiteFooter variant="code-buster" />
</BaseLayout>
