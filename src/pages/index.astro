---
import BaseLayout from "../layouts/BaseLayout.astro";
import BunkerHeroLandscape from "../components/BunkerHeroLandscape.astro";
import SiteFooter from "../components/SiteFooter.astro";
---

<BaseLayout
  title="Tool Bunker - Open-source tools, apps, and experiments"
  description="Tool Bunker is an open-source home for useful tools, apps, and playful experiments built in public."
  bodyClass="home-page"
>
    <style>
      .hero {
        position: relative;
        isolation: isolate;
        display: grid;
        min-height: max(54rem, 100svh);
        align-items: start;
        padding: clamp(5rem, 12vh, 8rem) 0 clamp(23rem, calc(53vw - 9rem), 55rem);
        overflow: hidden;
        background: #000;
      }
      .hero-inner { position: relative; z-index: 2; width: 100%; text-align: center; }
      h1 {
        display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 0.16em;
        margin: 1.7rem 0 1rem; font-family: var(--sans); font-size: clamp(3.4rem, 10vw, 7.2rem);
        letter-spacing: -0.075em; line-height: 0.9; text-transform: lowercase;
      }
      .hero-logo { width: 1.05em; height: auto; flex: none; }
      h1 em { color: var(--terminal); font-style: normal; }
      .tagline { max-width: 46rem; margin: 1.5rem auto 0; color: var(--text-dim); font-family: var(--sans); font-size: clamp(1.05rem, 2vw, 1.25rem); }
      .hero-actions { display: flex; justify-content: center; flex-wrap: wrap; gap: .8rem; margin-top: 2rem; }
      .hero-action { display: inline-flex; min-height: 2.8rem; align-items: center; padding: .65rem .9rem; border: 1px solid var(--line-strong); border-radius: 2px; color: var(--text); font: 700 .75rem var(--mono); text-decoration: none; }
      .hero-action-primary { border-color: var(--terminal); background: var(--terminal); color: var(--ink); }
      .hero-action:hover { border-color: var(--tape); }
      .scroll-mark { display: inline-block; margin-top: 2.5rem; color: var(--text-dimmer); font-family: var(--mono); font-size: 0.68rem; letter-spacing: 0.12em; text-decoration: none; text-transform: uppercase; }
      .scroll-mark:hover { color: var(--tape); }

      .tools { position: relative; z-index: 2; padding: 4.5rem 0 8rem; background: var(--ink); }
      .section-heading { display: flex; align-items: baseline; justify-content: space-between; gap: 2rem; padding-bottom: 1.2rem; border-bottom: 1px solid var(--line-strong); }
      .eyebrow { color: var(--terminal); font-family: var(--mono); font-size: 0.72rem; font-weight: 700; letter-spacing: 0.13em; text-transform: uppercase; }
      h2 { margin: 0; font-family: var(--sans); font-size: clamp(2rem, 5vw, 3.5rem); font-weight: 650; letter-spacing: -0.045em; line-height: 1.05; }
      .tool-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1.25rem; margin-top: 1.5rem; }
      .tool-card { position: relative; min-height: 21rem; padding: 2rem; overflow: hidden; border: 1px solid var(--line-strong); border-radius: 4px; background: var(--ink-2); }
      a.tool-card { color: var(--text); text-decoration: none; transition: border-color 0.15s ease, transform 0.15s ease; }
      a.tool-card:hover { border-color: var(--terminal); transform: translateY(-2px); }
      .tool-card.featured { display: grid; grid-column: 1 / -1; grid-template-columns: minmax(0, 0.82fr) minmax(22rem, 1.18fr); align-items: center; min-height: 25rem; background: var(--ink-2); }
      .tool-number { color: var(--text-dimmer); font-family: var(--mono); font-size: 0.68rem; }
      .tool-card h3 { margin: 2rem 0 0.8rem; font-family: var(--sans); font-size: clamp(1.5rem, 3vw, 2.4rem); letter-spacing: -0.035em; }
      .tool-card p { max-width: 38rem; margin: 0; color: var(--text-dim); }
      .tool-link { display: inline-block; margin-top: 2rem; color: var(--terminal); font-family: var(--mono); font-size: 0.8rem; font-weight: 700; }
      .tool-art { position: relative; align-self: stretch; display: grid; place-items: center; }
      .tool-art::before { position: absolute; inset: 20%; border-radius: 50%; background: rgb(231 221 190 / 8%); filter: blur(3rem); content: ""; }
      .tool-art img { position: relative; width: min(68%, 18rem); height: auto; filter: drop-shadow(0 1.5rem 2.5rem rgb(0 0 0 / 45%)); }
      .tool-card.codebuster-card { border-color: rgb(var(--code-buster-primary-rgb) / 24%); background-color: var(--ink-2); background-image: linear-gradient(135deg, rgb(var(--code-buster-primary-rgb) / 7%), transparent 55%); }
      a.tool-card.codebuster-card:hover { border-color: var(--code-buster-link); }
      .codebuster-card .tool-link { color: var(--code-buster-link); }
      .codebuster-card .tool-art::before { background: rgb(var(--code-buster-primary-rgb) / 12%); }
      .codebuster-card .tool-art img { width: min(56%, 16rem); }
      .tool-card.spaghetti-card { border-color: rgb(var(--spaghetti-primary-rgb) / 24%); background-color: var(--ink-2); background-image: linear-gradient(135deg, rgb(var(--spaghetti-primary-rgb) / 10%), rgb(var(--spaghetti-secondary-rgb) / 5%) 58%, transparent 80%); }
      a.tool-card.spaghetti-card:hover { border-color: var(--spaghetti-primary); }
      .spaghetti-card .tool-link { color: var(--spaghetti-secondary); }
      .spaghetti-card .tool-art::before { background: linear-gradient(135deg, rgb(var(--spaghetti-primary-rgb) / 20%), rgb(var(--spaghetti-secondary-rgb) / 14%)); }
      .spaghetti-card .tool-art img { width: min(56%, 16rem); }

      .principles { padding: 7rem 0; border-top: 1px solid var(--line); }
      .principles-grid { display: grid; grid-template-columns: 0.7fr 1.3fr; gap: clamp(3rem, 9vw, 8rem); }
      .principles h2 { margin-top: 0.65rem; }
      .principle-list { display: grid; grid-template-columns: 1fr 1fr; border: 1px solid var(--line-strong); background: var(--line-strong); gap: 1px; }
      .principle { min-height: 10rem; padding: 1.5rem; background: var(--ink-2); }
      .principle strong { display: block; margin-bottom: 0.7rem; color: var(--terminal); font-family: var(--sans); font-weight: 650; }
      .principle p { margin: 0; color: var(--text-dim); font-size: 0.9rem; }
      .about { padding: 7rem 0; border-block: 1px solid var(--line); background: rgb(231 221 190 / 2%); }
      .about-grid { display: grid; grid-template-columns: 0.55fr 1.45fr; gap: clamp(3rem, 9vw, 8rem); }
      .about-copy { max-width: 48rem; }
      .about-copy h2 { margin-bottom: 1.5rem; }
      .about-copy p { margin: 0; color: var(--text-dim); font-size: clamp(1.05rem, 2vw, 1.25rem); }
      .about-copy p + p { margin-top: 1rem; }
      .about-copy a { color: var(--terminal); font-weight: 600; text-decoration-color: rgb(111 190 140 / 45%); text-underline-offset: 0.2em; }
      .about-copy a:hover { text-decoration-color: var(--terminal); }

      @media (max-width: 720px) {
        .hero { min-height: 56rem; padding: 4rem 0 24rem; }
        .hero-inner { padding-inline: 1rem; }
        .tool-grid, .about-grid, .principles-grid { grid-template-columns: 1fr; }
        .tool-card.featured { grid-template-columns: 1fr; padding-bottom: 2rem; }
        .tool-card.featured .tool-art { order: -1; min-height: 12rem; margin: 0 0 .5rem; padding: 0; }
        .tool-card { min-height: 18rem; }
        .principle-list { grid-template-columns: 1fr; }
      }
    </style>
    <main id="main-content">
      <section class="hero" aria-labelledby="site-title">
        <BunkerHeroLandscape />
        <div class="wrap hero-inner">
          <h1 id="site-title"><img class="hero-logo" src="/toolbunker_logo_green.svg" alt="" width="307" height="359" /> <span>tool<em>bunker</em></span></h1>
          <p class="tagline">Practical tools, apps, and playful experiments—open-source, transparent, and made for anyone who finds them useful.</p>
          <div class="hero-actions">
            <a class="hero-action hero-action-primary" href="/codebuster/">Explore Code Buster →</a>
            <a class="hero-action" href="https://github.com/tool-bunker">View source on GitHub ↗</a>
          </div>
          <a class="scroll-mark" href="#tools">Explore the projects ↓</a>
        </div>
      </section>

      <section class="tools" id="tools" aria-labelledby="tools-title">
        <div class="wrap">
          <div class="section-heading">
            <h2 id="tools-title">The projects</h2>
          </div>
          <div class="tool-grid">
            <a class="tool-card featured codebuster-card" href="/codebuster/">
              <div class="tool-copy">
                <span class="tool-number">TOOL / 001</span>
                <h3>Code Buster</h3>
                <p>Repository-aware static analysis for AI-assisted development. Code Buster gives coding agents deterministic repository evidence without calling another AI model.</p>
                <span class="tool-link">Inspect Code Buster →</span>
              </div>
              <div class="tool-art">
                <img src="/codebuster_logo.svg" alt="Code Buster logo" width="334" height="334" loading="lazy" decoding="async" />
              </div>
            </a>
            <a class="tool-card featured spaghetti-card" href="/spaghetti-meter/">
              <div class="tool-copy">
                <span class="tool-number">APP / 002</span>
                <h3>Spaghetti Meter</h3>
                <p>A local desktop app that measures how tangled a repository is, then drops the score into a bowl of animated spaghetti.</p>
                <span class="tool-link">Meet Spaghetti Meter →</span>
              </div>
              <div class="tool-art">
                <img src="/spaghetti.svg" alt="Spaghetti Meter app icon" width="543" height="543" loading="lazy" decoding="async" />
              </div>
            </a>
          </div>
        </div>
      </section>

      <section class="principles" id="principles" aria-labelledby="principles-title">
        <div class="wrap principles-grid">
          <div>
            <span class="eyebrow">How it’s built</span>
            <h2 id="principles-title">Principles behind the work.</h2>
          </div>
          <div class="principle-list">
            <article class="principle"><strong>Open by default.</strong><p>Source, issues, decisions, and development belong where everyone can participate.</p></article>
            <article class="principle"><strong>Simple enough to maintain.</strong><p>Clear, understandable projects are easier to use, improve, and keep alive.</p></article>
          </div>
        </div>
      </section>

      <section class="about" id="about" aria-labelledby="about-title">
        <div class="wrap about-grid">
          <span class="eyebrow">About the project</span>
          <div class="about-copy">
            <h2 id="about-title">Useful things.<br />Built in the open.</h2>
            <p>Tool Bunker is an open-source home for practical tools, apps, and playful experiments, built in public and open to anyone who wants to use, discuss, or improve them.</p>
            <p>This is not a company or a product suite. It is a place for useful ideas and open collaboration, with the hope that it grows into a group of contributors making things people enjoy using.</p>
            <p>Tool Bunker is currently maintained by <a href="https://github.com/robertsson">@robertsson</a>.</p>
          </div>
        </div>
      </section>
    </main>
    <SiteFooter />
</BaseLayout>
