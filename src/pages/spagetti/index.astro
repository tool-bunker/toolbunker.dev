---
import BaseLayout from "../../layouts/BaseLayout.astro";
import SiteFooter from "../../components/SiteFooter.astro";

const softwareJsonLd = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "Spagetti",
  applicationCategory: "DeveloperApplication",
  operatingSystem: "macOS, Linux, Windows",
  softwareVersion: "0.1.0",
  description: "A local desktop app that measures repository tangles and turns the score into a bowl of animated spaghetti.",
  license: "https://opensource.org/license/mit",
};
---

<BaseLayout
  title="Spagetti - A playful repository mess meter"
  description="Spagetti is a local desktop app that measures repository tangles with Code Buster and turns the score into a bowl of animated spaghetti."
  favicon="/spaghetti.svg"
  image="/spaghetti.svg"
  bodyClass="spagetti-page"
>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(softwareJsonLd)}></script>
  <style>
    :global(.spagetti-page) {
      --sp-bg: #18130f;
      --sp-panel: #211a15;
      --sp-panel-strong: #2a211a;
      --sp-cream: #fff6e8;
      --sp-body: #b7a99b;
      --sp-muted: #a99c91;
      --sp-yellow: #ffd55a;
      --sp-red: #d76550;
      background: var(--sp-bg);
      color: var(--sp-cream);
    }

    .app-header {
      padding: 1.25rem 0;
      border-bottom: 1px solid rgb(255 246 232 / 12%);
    }

    .app-nav {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 1.5rem;
    }

    .app-brand,
    .app-links a {
      color: var(--sp-body);
      font: 700 .7rem var(--mono);
      letter-spacing: .08em;
      text-decoration: none;
      text-transform: uppercase;
    }

    .app-brand { color: var(--sp-yellow); }
    .app-links { display: flex; flex-wrap: wrap; gap: 1.25rem; }
    .app-links a:hover { color: var(--sp-yellow); }

    .hero {
      position: relative;
      overflow: hidden;
      padding: clamp(5rem, 10vw, 8rem) 0 6rem;
      border-bottom: 1px solid rgb(255 246 232 / 12%);
      background:
        radial-gradient(circle at 82% 38%, rgb(215 101 80 / 16%), transparent 24rem),
        radial-gradient(circle at 18% 18%, rgb(255 213 90 / 8%), transparent 28rem),
        var(--sp-bg);
    }

    .hero-grid {
      display: grid;
      grid-template-columns: minmax(0, 1.1fr) minmax(20rem, .9fr);
      align-items: center;
      gap: clamp(3rem, 8vw, 8rem);
    }

    .status {
      display: inline-flex;
      align-items: center;
      gap: .55rem;
      padding: .45rem .7rem;
      border: 1px solid rgb(255 213 90 / 42%);
      border-radius: 999px;
      color: var(--sp-yellow);
      font: 700 .65rem var(--mono);
      letter-spacing: .09em;
      text-transform: uppercase;
    }

    .status::before {
      width: .45rem;
      height: .45rem;
      border-radius: 50%;
      background: var(--sp-red);
      content: "";
    }

    h1,
    h2,
    h3 { font-family: var(--sans); }

    h1 {
      max-width: 11ch;
      margin: 1.5rem 0;
      font-size: clamp(3.1rem, 7vw, 6.2rem);
      font-weight: 650;
      letter-spacing: -.06em;
      line-height: .94;
    }

    h1 em { color: var(--sp-yellow); font-style: normal; }

    .lede {
      max-width: 42rem;
      margin: 0;
      color: var(--sp-body);
      font-size: clamp(1.05rem, 2vw, 1.25rem);
    }

    .hero-actions {
      display: flex;
      flex-wrap: wrap;
      gap: .8rem;
      margin-top: 2rem;
    }

    .button {
      display: inline-flex;
      min-height: 3rem;
      align-items: center;
      justify-content: center;
      padding: .7rem 1rem;
      border: 1px solid rgb(255 246 232 / 24%);
      border-radius: 3px;
      color: var(--sp-cream);
      font: 700 .74rem var(--mono);
      text-decoration: none;
    }

    .button-primary {
      border-color: var(--sp-yellow);
      background: var(--sp-yellow);
      color: #24150e;
    }

    .button:hover { border-color: var(--sp-red); }

    .release-note {
      margin: 1.2rem 0 0;
      color: var(--sp-muted);
      font: .68rem var(--mono);
    }

    .logo-stage {
      position: relative;
      display: grid;
      min-height: 31rem;
      place-items: center;
    }

    .logo-stage::before,
    .logo-stage::after {
      position: absolute;
      border-radius: 50%;
      content: "";
    }

    .logo-stage::before {
      inset: 7%;
      border: 1px solid rgb(255 213 90 / 17%);
      background: radial-gradient(circle, rgb(255 213 90 / 9%), transparent 64%);
    }

    .logo-stage::after {
      inset: 19%;
      border: 1px dashed rgb(215 101 80 / 28%);
    }

    .logo-stage img {
      position: relative;
      z-index: 1;
      width: min(82%, 25rem);
      height: auto;
      filter: drop-shadow(0 2rem 3rem rgb(0 0 0 / 45%));
    }

    .facts {
      border-bottom: 1px solid rgb(255 246 232 / 12%);
      background: var(--sp-panel);
    }

    .facts-grid {
      display: grid;
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }

    .fact {
      min-height: 8rem;
      padding: 1.5rem;
      border-right: 1px solid rgb(255 246 232 / 12%);
    }

    .fact:last-child { border-right: 0; }
    .fact strong { display: block; color: var(--sp-yellow); font-size: 1.2rem; }
    .fact span { color: var(--sp-muted); font: .67rem var(--mono); letter-spacing: .08em; text-transform: uppercase; }

    .section { padding: 7rem 0; }
    .section + .section { border-top: 1px solid rgb(255 246 232 / 12%); }

    .section-heading {
      display: grid;
      grid-template-columns: minmax(0, .72fr) minmax(0, 1.28fr);
      align-items: end;
      gap: clamp(2rem, 7vw, 6rem);
      margin-bottom: 2.5rem;
    }

    .eyebrow {
      color: var(--sp-red);
      font: 700 .68rem var(--mono);
      letter-spacing: .12em;
      text-transform: uppercase;
    }

    h2 {
      margin: .65rem 0 0;
      font-size: clamp(2.2rem, 5vw, 4rem);
      font-weight: 650;
      letter-spacing: -.05em;
      line-height: 1;
    }

    .section-heading p {
      max-width: 46rem;
      margin: 0;
      color: var(--sp-body);
      font-size: 1.05rem;
    }

    .steps,
    .feature-grid {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 1px;
      border: 1px solid rgb(255 246 232 / 14%);
      background: rgb(255 246 232 / 14%);
    }

    .step,
    .feature-card {
      min-height: 17rem;
      padding: 1.6rem;
      background: var(--sp-panel);
    }

    .step span,
    .feature-card span {
      color: var(--sp-yellow);
      font: 700 .65rem var(--mono);
      letter-spacing: .1em;
    }

    h3 {
      margin: 2rem 0 .75rem;
      font-size: 1.25rem;
      letter-spacing: -.025em;
    }

    .step p,
    .feature-card p { margin: 0; color: var(--sp-body); }
    .formula-panel {
      display: grid;
      grid-template-columns: minmax(0, .9fr) minmax(0, 1.1fr);
      gap: 1px;
      border: 1px solid rgb(255 246 232 / 14%);
      background: rgb(255 246 232 / 14%);
    }

    .formula-copy,
    .score-table-wrap { min-width: 0; padding: clamp(1.5rem, 4vw, 2.5rem); background: var(--sp-panel); }
    .score-table-wrap { overflow-x: auto; }

    .formula {
      margin: 1.5rem 0;
      padding: 1.2rem;
      overflow-x: auto;
      border: 1px solid rgb(255 213 90 / 28%);
      background: #120e0b;
      color: var(--sp-yellow);
      font: 700 clamp(.85rem, 2vw, 1.05rem) var(--mono);
      white-space: nowrap;
    }

    .formula-copy p { color: var(--sp-body); }

    table { width: 100%; border-collapse: collapse; }
    caption { margin-bottom: 1rem; color: var(--sp-cream); font-weight: 650; text-align: left; }
    th, td { padding: .75rem .55rem; border-bottom: 1px solid rgb(255 246 232 / 12%); text-align: left; }
    th { color: var(--sp-muted); font: 700 .62rem var(--mono); letter-spacing: .08em; text-transform: uppercase; }
    td { color: var(--sp-body); font-size: .88rem; }
    td:first-child { color: var(--sp-yellow); font-family: var(--mono); }

    .local-section { background: var(--sp-panel); }
    .local-grid { display: grid; grid-template-columns: minmax(0, .8fr) minmax(0, 1.2fr); gap: clamp(3rem, 8vw, 7rem); align-items: center; }
    .local-copy p { color: var(--sp-body); font-size: 1.05rem; }

    .trust-list { display: grid; gap: 1px; border: 1px solid rgb(255 246 232 / 14%); background: rgb(255 246 232 / 14%); }
    .trust-item { padding: 1.3rem; background: var(--sp-bg); }
    .trust-item strong { display: block; margin-bottom: .35rem; color: var(--sp-yellow); }
    .trust-item span { color: var(--sp-body); }

    .release-card {
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: center;
      gap: 2rem;
      padding: clamp(2rem, 5vw, 3.5rem);
      border: 1px solid rgb(255 213 90 / 30%);
      background: linear-gradient(135deg, rgb(255 213 90 / 8%), transparent 48%), var(--sp-panel);
    }

    .release-card h2 { max-width: 16ch; }
    .release-card p { max-width: 46rem; color: var(--sp-body); }
    .release-badge { padding: .8rem 1rem; border: 1px solid var(--sp-yellow); color: var(--sp-yellow); font: 700 .7rem var(--mono); text-transform: uppercase; }

    @media (max-width: 52rem) {
      .hero-grid,
      .section-heading,
      .formula-panel,
      .local-grid { grid-template-columns: 1fr; }
      .logo-stage { min-height: 23rem; }
      .facts-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
      .fact:nth-child(2) { border-right: 0; }
      .fact:nth-child(-n + 2) { border-bottom: 1px solid rgb(255 246 232 / 12%); }
      .steps,
      .feature-grid { grid-template-columns: 1fr; }
      .step,
      .feature-card { min-height: 0; }
      .release-card { grid-template-columns: 1fr; }
    }

    @media (max-width: 35rem) {
      .app-nav { align-items: flex-start; flex-direction: column; }
      .facts-grid { grid-template-columns: 1fr; }
      .fact { border-right: 0; border-bottom: 1px solid rgb(255 246 232 / 12%); }
      .fact:last-child { border-bottom: 0; }
    }
  </style>

  <header class="app-header">
    <div class="wrap app-nav">
      <a class="app-brand" href="/">Tool Bunker / Spagetti</a>
      <nav class="app-links" aria-label="Spagetti navigation">
        <a href="/#tools">Projects</a>
        <a href="/codebuster/">Code Buster</a>
      </nav>
    </div>
  </header>

  <main id="main-content">
    <section class="hero" aria-labelledby="spagetti-title">
      <div class="wrap hero-grid">
        <div>
          <span class="status">Version 0.1.0 · pre-release</span>
          <h1 id="spagetti-title">Measure the mess. <em>Serve the bowl.</em></h1>
          <p class="lede">Spagetti is a cross-platform desktop app that measures how tangled a repository is, then drops the result into a bowl of animated spaghetti. The scan runs locally and your source code stays on your computer.</p>
          <div class="hero-actions">
            <a class="button button-primary" href="#how-it-works">See how it works ↓</a>
            <a class="button" href="/codebuster/">Meet the analysis engine →</a>
          </div>
          <p class="release-note">Desktop downloads are being prepared for macOS ARM64, Linux x64, and Windows x64.</p>
        </div>
        <div class="logo-stage">
          <img src="/spaghetti.svg" alt="Spagetti bowl logo" width="543" height="420" decoding="async" fetchpriority="high" />
        </div>
      </div>
    </section>

    <section class="facts" aria-label="Spagetti facts">
      <div class="wrap facts-grid">
        <div class="fact"><strong>Local</strong><span>Source stays on-device</span></div>
        <div class="fact"><strong>3</strong><span>Desktop targets</span></div>
        <div class="fact"><strong>100</strong><span>Full-bowl baseline</span></div>
        <div class="fact"><strong>MIT</strong><span>Open-source license</span></div>
      </div>
    </section>

    <section class="section" id="how-it-works" aria-labelledby="how-title">
      <div class="wrap">
        <div class="section-heading">
          <div><span class="eyebrow">From folder to food</span><h2 id="how-title">Pick a project. Watch the bowl fill.</h2></div>
          <p>The visualization explains the measurement; it is not a second analysis engine. Code Buster produces the repository evidence, and Spagetti turns the resulting score into something immediate and memorable.</p>
        </div>
        <div class="steps">
          <article class="step"><span>01 / SELECT</span><h3>Choose a folder</h3><p>Native folder selection starts the scan immediately. No command line or separate Code Buster installation is required.</p></article>
          <article class="step"><span>02 / MEASURE</span><h3>Analyze locally</h3><p>The bundled, pinned Code Buster engine evaluates the repository and returns weighted findings without uploading source code.</p></article>
          <article class="step"><span>03 / SERVE</span><h3>Drop the noodles</h3><p>Rapier soft bodies and PixiJS turn the score into physical strands that fall, collide, settle, and overflow the bowl.</p></article>
        </div>
      </div>
    </section>

    <section class="section" aria-labelledby="score-title">
      <div class="wrap">
        <div class="section-heading">
          <div><span class="eyebrow">The recipe</span><h2 id="score-title">A score you can see.</h2></div>
          <p>Advisory findings count once, actionable findings count three times, and the result is normalized against the number of analyzed files. The score is intentionally unbounded.</p>
        </div>
        <div class="formula-panel">
          <div class="formula-copy">
            <h3>Repository spaghetti score</h3>
            <div class="formula" tabindex="0">100 × weighted findings ÷ max(analyzed files, 10)</div>
            <p>A score of 100 means one weighted finding per analyzed file and fills the bowl. Higher scores remain distinguishable because excess noodles spill over the rim instead of being capped.</p>
          </div>
          <div class="score-table-wrap">
            <table>
              <caption>Plain-language verdicts</caption>
              <thead><tr><th scope="col">Score</th><th scope="col">Verdict</th></tr></thead>
              <tbody>
                <tr><td>0–20</td><td>Atomic code spaghetti</td></tr>
                <tr><td>21–50</td><td>Light spaghetti</td></tr>
                <tr><td>51–80</td><td>Expected spaghetti</td></tr>
                <tr><td>81–100</td><td>Full but expected spaghetti</td></tr>
                <tr><td>101–150</td><td>Messy spaghetti</td></tr>
                <tr><td>151+</td><td>Spaghetti catastrophe</td></tr>
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </section>

    <section class="section local-section" aria-labelledby="local-title">
      <div class="wrap local-grid">
        <div class="local-copy">
          <span class="eyebrow">Local by design</span>
          <h2 id="local-title">Your repository stays yours.</h2>
          <p>Spagetti bundles a pinned Code Buster executable as a Tauri sidecar. It does not install a global CLI, mutate your PATH, or depend on a network connection for the first scan.</p>
        </div>
        <div class="trust-list">
          <div class="trust-item"><strong>No source upload</strong><span>The selected repository is analyzed on your computer.</span></div>
          <div class="trust-item"><strong>Offline-capable</strong><span>The installed app carries the analysis engine and matching report schema.</span></div>
          <div class="trust-item"><strong>Reduced motion</strong><span>Operating-system motion preferences switch the noodle drop to an equivalent static layout.</span></div>
          <div class="trust-item"><strong>Transparent licensing</strong><span>The MIT app includes generated third-party notices for production and runtime dependencies.</span></div>
        </div>
      </div>
    </section>

    <section class="section" aria-labelledby="features-title">
      <div class="wrap">
        <div class="section-heading">
          <div><span class="eyebrow">Under the bowl</span><h2 id="features-title">Playful outside. Deliberate inside.</h2></div>
          <p>The bowl is more than a canned animation. Every noodle is an independently simulated rope with structural and bending constraints, collision depth, and deterministic serving size.</p>
        </div>
        <div class="feature-grid">
          <article class="feature-card"><span>PIXEL / MOTION</span><h3>PixiJS rendering</h3><p>A full-window PixiJS scene renders the interface, bowl, score, and smooth MeshRope noodles.</p></article>
          <article class="feature-card"><span>PHYSICS / COLLISION</span><h3>Rapier soft bodies</h3><p>Twelve simulated particles per noodle create physical piles, neighboring collisions, and natural overflow.</p></article>
          <article class="feature-card"><span>DESKTOP / NATIVE</span><h3>Tauri application</h3><p>Native folder selection and a bundled analysis sidecar provide a focused desktop workflow across three target platforms.</p></article>
        </div>
      </div>
    </section>

    <section class="section" aria-labelledby="release-title">
      <div class="wrap release-card">
        <div>
          <span class="eyebrow">Release status</span>
          <h2 id="release-title">The first serving is still in the kitchen.</h2>
          <p>Spagetti 0.1.0 is currently pre-release. Desktop download links will be added here when release builds are ready.</p>
        </div>
        <span class="release-badge">Downloads coming soon</span>
      </div>
    </section>
  </main>

  <SiteFooter />
</BaseLayout>
