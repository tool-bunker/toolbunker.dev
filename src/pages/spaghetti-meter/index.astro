---
import BaseLayout from "../../layouts/BaseLayout.astro";
import SiteFooter from "../../components/SiteFooter.astro";

const repositoryUrl = "https://github.com/tool-bunker/spaghetti-meter";
const releaseUrl = `${repositoryUrl}/releases/tag/v0.1.2`;

const softwareJsonLd = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "Spaghetti Meter",
  applicationCategory: "UtilitiesApplication",
  operatingSystem: "macOS, Linux, Windows",
  softwareVersion: "0.1.2",
  description: "A playful desktop app that turns a local project into a bowl of animated spaghetti.",
  license: "https://opensource.org/license/mit",
  url: "https://toolbunker.dev/spaghetti-meter/",
  sameAs: repositoryUrl,
  downloadUrl: releaseUrl,
};

// Raw counts from the pinned Code Buster 0.14.4 runs, before score weighting.
const showcaseRuns = [
